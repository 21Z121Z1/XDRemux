{
  "schema_version": 1,
  "scope": "Provisional revised PR69 after revised PR58: ordered/mirrored RGB8/HEIF orientation plus the media-safe publisher. Local exact-head portable evidence only; actual preceding server main ancestry and native/ImageIO/App/performance acceptance remain required. Each candidate now uses its own Cargo target directory; the prior shared-target failure remains separate evidence.",
  "checks": [
    {
      "name": "locked-workspace",
      "kind": "static",
      "command": [
        "cargo",
        "metadata",
        "--locked",
        "--no-deps",
        "--format-version",
        "1"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "rust-format",
      "kind": "static",
      "command": [
        "cargo",
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "rust-workspace-clippy",
      "kind": "static",
      "command": [
        "cargo",
        "clippy",
        "--locked",
        "--workspace",
        "--all-targets",
        "--",
        "--deny",
        "warnings"
      ],
      "timeout_seconds": 1200
    },
    {
      "name": "media-safe-pair-publication",
      "kind": "regression",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "xdremux-motion-photo",
        "--lib",
        "publication::tests"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "media-publication-runtime-negatives",
      "kind": "regression",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "xdremux-runtime",
        "--test",
        "live_photo_negative"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "codec-and-heif-unit-regressions",
      "kind": "regression",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "xdremux-codec",
        "-p",
        "xdremux-heif",
        "--lib"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "heif-boundary-negatives",
      "kind": "regression",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "xdremux-heif",
        "--test",
        "fail_closed"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "real-oriented-samsung-codec-roundtrip",
      "kind": "functional",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "xdremux-codec",
        "--test",
        "orientation_roundtrip"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "all-portable-python-regressions",
      "kind": "regression",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-t",
        ".",
        "-v"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "build-current-cli",
      "kind": "functional",
      "command": [
        "cargo",
        "build",
        "--locked",
        "-p",
        "xdremux-cli"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "real-cli-pair-conversion-and-readback",
      "kind": "functional",
      "command": [
        "python3",
        "/workspace/xdremux-audit/verify-current-cli.py"
      ],
      "timeout_seconds": 600,
      "env": {
        "XDREMUX_VERIFY_CLI": "/tmp/xdremux-pr69-target/debug/xdremux"
      }
    }
  ]
}
