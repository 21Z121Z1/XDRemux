{
  "schema_version": 1,
  "scope": "Committed-HEAD portable validation of Live Photo operation-owned staging, nondestructive reconciliation, no-clobber pair publication and recoverable partial errors; atomic CLI fixture directories; bounded HEIF alpha subtype diagnostics; same-runner performance comparison tooling. Run the full Rust workspace once because publication is shared by direct and batch conversion. All Python regressions and a real current-build Samsung pair readback remain required. Apple product/App, native System HEIF subtype facts, performance absolute budget and interleaved comparison, both macOS package architectures and device acceptance remain separate evidence; this receipt cannot establish them.",
  "checks": [
    {
      "name": "locked-workspace",
      "kind": "static",
      "command": [
        "cargo",
        "metadata",
        "--locked",
        "--no-deps",
        "--format-version",
        "1"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "rust-format",
      "kind": "static",
      "command": [
        "cargo",
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "rust-workspace-clippy",
      "kind": "static",
      "command": [
        "cargo",
        "clippy",
        "--locked",
        "--workspace",
        "--all-targets",
        "--",
        "--deny",
        "warnings"
      ],
      "timeout_seconds": 1200
    },
    {
      "name": "full-rust-workspace-and-real-process-regressions",
      "kind": "regression",
      "command": [
        "cargo",
        "test",
        "--locked",
        "--workspace"
      ],
      "timeout_seconds": 1800
    },
    {
      "name": "all-portable-python-regressions",
      "kind": "regression",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-t",
        ".",
        "-v"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "build-current-cli",
      "kind": "functional",
      "command": [
        "cargo",
        "build",
        "--locked",
        "-p",
        "xdremux-cli"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "real-cli-pair-conversion-and-readback",
      "kind": "functional",
      "command": [
        "python3",
        "/workspace/xdremux-audit/verify-current-cli.py"
      ],
      "timeout_seconds": 600,
      "env": {
        "XDREMUX_VERIFY_CLI": "/workspace/XDRemux-integration/target/debug/xdremux"
      }
    }
  ]
}
