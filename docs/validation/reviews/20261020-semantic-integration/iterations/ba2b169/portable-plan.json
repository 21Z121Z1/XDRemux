{
  "schema_version": 1,
  "scope": "Portable validation of native Styles diagnostic storage/version handling and bounded HEIF graph failure reporting on committed ba2b169. Apple/App/SystemHEIF/performance remain required native checks; old f9a419a fixture matrix remains separate evidence.",
  "checks": [
    {
      "name": "locked-workspace",
      "kind": "static",
      "command": [
        "cargo",
        "metadata",
        "--locked",
        "--no-deps",
        "--format-version",
        "1"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "rust-format",
      "kind": "static",
      "command": [
        "cargo",
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "rust-workspace-clippy",
      "kind": "static",
      "command": [
        "cargo",
        "clippy",
        "--locked",
        "--workspace",
        "--all-targets",
        "--",
        "--deny",
        "warnings"
      ],
      "timeout_seconds": 1200
    },
    {
      "name": "heif-graph-regressions",
      "kind": "regression",
      "command": [
        "cargo",
        "test",
        "--locked",
        "-p",
        "xdremux-heif",
        "--lib"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "all-portable-python-regressions",
      "kind": "regression",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-t",
        ".",
        "-v"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "build-current-cli",
      "kind": "functional",
      "command": [
        "cargo",
        "build",
        "--locked",
        "-p",
        "xdremux-cli"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "real-cli-pair-conversion-and-readback",
      "kind": "functional",
      "command": [
        "python3",
        "/workspace/xdremux-audit/verify-current-cli.py"
      ],
      "timeout_seconds": 600
    }
  ]
}
