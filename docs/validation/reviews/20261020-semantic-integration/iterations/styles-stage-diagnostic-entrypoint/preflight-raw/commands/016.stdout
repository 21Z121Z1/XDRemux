name: XDRemux Rust Performance and Design

on:
  pull_request:
    paths:
      - "Cargo.toml"
      - "Cargo.lock"
      - "crates/**"
      - "Sources/XDRemuxAppleAdapter/**"
      - "Sources/XDTextureNative/**"
      - "Package.swift"
      - "benchmarks/macos26-arm64-product-baseline.json"
      - "benchmarks/macos27-arm64-product-baseline.json"
      - "tests/test_performance_design.py"
      - "tests/test_performance_budget.py"
      - "scripts/performance/benchmark_rust_product.py"
      - "scripts/performance/compare_apple_styles_revisions.py"
      - "tests/test_styles_revision_comparison.py"
      - "scripts/performance/benchmark_apple_videotoolbox_primitive.py"
      - "scripts/performance/characterize_apple_adapter_launches.py"
      - "scripts/performance/check_performance_budget.py"
      - ".github/workflows/performance.yml"
  push:
    branches:
      - main
    paths:
      - "Cargo.toml"
      - "Cargo.lock"
      - "crates/**"
      - "Sources/XDRemuxAppleAdapter/**"
      - "Sources/XDTextureNative/**"
      - "Package.swift"
      - "benchmarks/macos26-arm64-product-baseline.json"
      - "benchmarks/macos27-arm64-product-baseline.json"
      - "tests/test_performance_design.py"
      - "tests/test_performance_budget.py"
      - "scripts/performance/benchmark_rust_product.py"
      - "scripts/performance/compare_apple_styles_revisions.py"
      - "tests/test_styles_revision_comparison.py"
      - "scripts/performance/benchmark_apple_videotoolbox_primitive.py"
      - "scripts/performance/characterize_apple_adapter_launches.py"
      - "scripts/performance/check_performance_budget.py"
      - ".github/workflows/performance.yml"
  workflow_dispatch:
    inputs:
      mode:
        description: Normal budget checks or the pinned diagnostic
        type: choice
        required: true
        default: standard
        options: [standard, styles-stage-attribution]
      reviewed_entrypoint_sha:
        description: Full reviewed entrypoint commit; required for diagnostics
        type: string
        required: false
        default: ''

permissions:
  contents: read

jobs:
  rust-performance:
    if: ${{ (github.event_name != 'workflow_dispatch' || inputs.mode == 'standard') && github.ref != 'refs/tags/review/styles-stage-diagnostic-20261021-v1' }}
    concurrency:
      group: xdremux-performance-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
      cancel-in-progress: true
    runs-on: xcode-27
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v7
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0

      - name: Record benchmark environment
        shell: bash
        run: |
          mkdir -p artifacts/performance
          {
            echo "runner_provider=GitHub Actions hosted runner"
            echo "runs_on=xcode-27"
            echo "head=$(git rev-parse HEAD)"
            sw_vers
            echo "arch=$(uname -m)"
            sysctl hw.model machdep.cpu.brand_string hw.physicalcpu hw.logicalcpu hw.memsize
            uptime
            xcodebuild -version
            swift --version
          } | tee artifacts/performance/environment.txt

      - name: Install portable HEVC provider
        shell: bash
        run: |
          brew install libheif
          echo "PKG_CONFIG_PATH=$(brew --prefix libheif)/lib/pkgconfig" >> "$GITHUB_ENV"

      - uses: actions-rust-lang/setup-rust-toolchain@v2
        with:
          toolchain: stable

      - name: Build optimized Rust product
        shell: bash
        run: |
          cargo build --locked --workspace --all-targets --release \
            2>&1 | tee artifacts/performance/rust-release-build.log

      - name: Build release Apple primitive adapter
        shell: bash
        run: |
          swift build -c release --product xdremux-apple-adapter \
            2>&1 | tee artifacts/performance/apple-adapter-build.log
          echo "XDREMUX_PERF_APPLE_ADAPTER=$(swift build -c release --show-bin-path)/xdremux-apple-adapter" >> "$GITHUB_ENV"

      - name: Check performance policy
        shell: bash
        run: |
          python3 -m unittest \
            tests.test_performance_design \
            tests.test_performance_budget \
            tests.test_styles_revision_comparison \
            2>&1 | tee artifacts/performance/design-policy.log

      - name: Require actual release RGB8 scene equivalence on the native host
        shell: bash
        run: |
          cargo test --locked --release -p xdremux-runtime --lib \
            apple_styles::tests::style_scene_preserves_every_rgb8_code_and_row_stride \
            -- --exact --nocapture \
            2>&1 | tee artifacts/performance/rgb8-scene-equivalence.log
          python3 - <<'PY'
          from pathlib import Path
          import re
          text = re.sub(r'\x1b\[[0-9;]*m', '', Path('artifacts/performance/rgb8-scene-equivalence.log').read_text())
          assert 'test apple_styles::tests::style_scene_preserves_every_rgb8_code_and_row_stride ... ok' in text
          assert '1 passed; 0 failed; 0 ignored;' in text, 'missing or skipped native RGB8 scene evidence'
          PY

      - name: Measure representative end-to-end product workloads
        shell: bash
        run: |
          python3 scripts/performance/benchmark_rust_product.py \
            --cli "$GITHUB_WORKSPACE/target/release/xdremux" \
            --apple-adapter "$XDREMUX_PERF_APPLE_ADAPTER" \
            --warmup 1 \
            --iterations 5 \
            --output artifacts/performance/product-benchmark.json \
            2>&1 | tee artifacts/performance/product-benchmark.log

      - name: Measure isolated portable Gain Map codec primitives
        shell: bash
        run: |
          "$GITHUB_WORKSPACE/target/release/xdremux-codec-gainmap-bench" \
            --width 1024 \
            --height 768 \
            --warmup 1 \
            --iterations 5 \
            > artifacts/performance/gain-map-codec.json
          cat artifacts/performance/gain-map-codec.json

      - name: Measure Apple VideoToolbox primitive separately
        shell: bash
        run: |
          python3 scripts/performance/benchmark_apple_videotoolbox_primitive.py \
            --apple-adapter "$XDREMUX_PERF_APPLE_ADAPTER" \
            --width 1024 \
            --height 768 \
            --warmup 1 \
            --iterations 5 \
            --output artifacts/performance/apple-videotoolbox-main10.json \
            2>&1 | tee artifacts/performance/apple-videotoolbox-main10.log

      - name: Characterize Apple adapter process lifecycle
        shell: bash
        run: |
          python3 scripts/performance/characterize_apple_adapter_launches.py \
            --cli "$GITHUB_WORKSPACE/target/release/xdremux" \
            --apple-adapter "$XDREMUX_PERF_APPLE_ADAPTER" \
            --output artifacts/performance/apple-adapter-launches.json \
            2>&1 | tee artifacts/performance/apple-adapter-launches.log

      - name: Enforce stable-runner performance regression budget
        shell: bash
        run: |
          python3 scripts/performance/check_performance_budget.py \
            --baseline benchmarks/macos27-arm64-product-baseline.json \
            --benchmark artifacts/performance/product-benchmark.json \
            --launches artifacts/performance/apple-adapter-launches.json \
            --expected-head "$(git rev-parse HEAD)" \
            2>&1 | tee artifacts/performance/regression-budget.log

      - name: Compare exact Styles revisions on the same runner
        if: ${{ !cancelled() }}
        shell: bash
        env:
          XDREMUX_PERF_PR_BASE_SHA: ${{ github.event.pull_request.base.sha || '' }}
        run: |
          python3 scripts/performance/compare_apple_styles_revisions.py \
            --cli "$GITHUB_WORKSPACE/target/release/xdremux" \
            --apple-adapter "$XDREMUX_PERF_APPLE_ADAPTER" \
            --baseline-ref "${XDREMUX_PERF_PR_BASE_SHA:-refs/remotes/origin/main}" \
            --expected-head "$(git rev-parse HEAD)" \
            --output-dir artifacts/performance/styles-revision-comparison \
            2>&1 | tee artifacts/performance/styles-revision-comparison.log

      - name: Write performance summary
        if: always()
        shell: bash
        run: |
          {
            echo "## XDRemux Rust performance and design"
            echo
            echo "Runner: GitHub Actions hosted $(sw_vers -productName) $(sw_vers -productVersion) ($(uname -m)), label xcode-27. These are not local-device measurements."
            echo "Product E2E timings include source I/O, parsing, Gain Map decode/reconstruction, codec work, HEIF assembly/publication, and Apple adapter/framework overhead where applicable."
            echo "Standard HDR uses the portable Rust/libheif Gain Map encoder even on macOS; the Apple VideoToolbox Main10 primitive belongs to the Photographic Styles Linear Thumbnail path and is not treated as an RGB 4:4:4 Gain Map backend."
            echo "The committed macOS 27 arm64 reference includes joint Styles and Texture production and is a regression baseline, not a performance target; committed tolerances absorb normal hosted-runner noise while structural helper-launch maxima remain hard limits."
            echo
          } >> "$GITHUB_STEP_SUMMARY"
          if [[ -s artifacts/performance/product-benchmark.json ]]; then
            python3 - <<'PY' >> "$GITHUB_STEP_SUMMARY"
          import json
          from pathlib import Path

          report = json.loads(Path("artifacts/performance/product-benchmark.json").read_text())
          print("### End-to-end product workloads")
          print()
          print("| workload | source | Gain Map | codec path | median | p95 | max RSS |")
          print("| --- | --- | --- | --- | ---: | ---: | ---: |")
          for case in report["cases"]:
              source = case.get("source_family") or "—"
              channels = case.get("gain_map_channels")
              chroma = case.get("gain_map_chroma")
              gain_map = f"{channels}/{chroma}" if channels and chroma else "—"
              codec_path = case.get("codec_path") or "—"
              print(
                  f"| {case['name']} | {source} | {gain_map} | {codec_path} | "
                  f"{case['median_wall_seconds']:.3f}s | "
                  f"{case['p95_wall_seconds']:.3f}s | "
                  f"{case['max_peak_rss_bytes'] / (1024 * 1024):.1f} MiB |"
              )
          PY
          fi
          if [[ -s artifacts/performance/gain-map-codec.json ]]; then
            python3 - <<'PY' >> "$GITHUB_STEP_SUMMARY"
          import json
          from pathlib import Path

          report = json.loads(Path("artifacts/performance/gain-map-codec.json").read_text())
          print()
          print("### Isolated portable Gain Map encoder")
          print()
          print(f"Synthetic smooth raster: {report['width']}×{report['height']}; timing covers LibHeifProvider::encode_gain_map_tiles only.")
          print()
          print("| profile | raw raster | tiles | encoded resource | median | p95 |")
          print("| --- | ---: | ---: | ---: | ---: | ---: |")
          for case in report["cases"]:
              print(
                  f"| {case['channels']}/{case['chroma']} | "
                  f"{case['raw_raster_bytes'] / (1024 * 1024):.2f} MiB | "
                  f"{case['tile_count']} | "
                  f"{case['encoded_resource_bytes'] / 1024:.1f} KiB | "
                  f"{case['median_seconds']:.3f}s | {case['p95_seconds']:.3f}s |"
              )
          PY
          fi
          if [[ -s artifacts/performance/apple-videotoolbox-main10.json ]]; then
            python3 - <<'PY' >> "$GITHUB_STEP_SUMMARY"
          import json
          from pathlib import Path

          report = json.loads(Path("artifacts/performance/apple-videotoolbox-main10.json").read_text())
          profile = report["storage_profile"]
          print()
          print("### Apple VideoToolbox primitive (separate contract)")
          print()
          print("This is the Photographic Styles Linear Thumbnail Main10 primitive. It includes helper launch, RGB→BGRA staging, VT session creation, encode, and file I/O; it is not an RGB 4:4:4 UHDR Gain Map comparison.")
          print()
          print("| operation | storage | raw raster | encoded resource | median | p95 |")
          print("| --- | --- | ---: | ---: | ---: | ---: |")
          print(
              f"| {report['operation']} | Main10 {profile['chroma']} "
              f"{profile['luma_bit_depth']}-bit | "
              f"{report['raw_raster_bytes'] / (1024 * 1024):.2f} MiB | "
              f"{report['encoded_resource_bytes'] / 1024:.1f} KiB | "
              f"{report['median_seconds']:.3f}s | {report['p95_seconds']:.3f}s |"
          )
          PY
          fi
          if [[ -s artifacts/performance/apple-adapter-launches.json ]]; then
            python3 - <<'PY' >> "$GITHUB_STEP_SUMMARY"
          import json
          from pathlib import Path

          report = json.loads(Path("artifacts/performance/apple-adapter-launches.json").read_text())
          print()
          print("### Apple adapter process lifecycle")
          print()
          print("| workload | helper launches per conversion |")
          print("| --- | ---: |")
          for name, count in report["cases"].items():
              print(f"| {name} | {count} |")
          PY
          fi

      - name: Upload performance measurements
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: xdremux-rust-performance
          if-no-files-found: warn
          retention-days: 14
          path: artifacts/performance/

  styles-stage-diagnostic:
    if: ${{ github.event_name == 'workflow_dispatch' && inputs.mode == 'styles-stage-attribution' && github.repository == '21Z121Z1/XDRemux' && github.ref == 'refs/tags/review/styles-stage-diagnostic-20261021-v1' && inputs.reviewed_entrypoint_sha == github.sha && github.event.repository.visibility == 'public' && github.event.repository.private == false }}
    runs-on: xcode-27
    timeout-minutes: 120
    permissions:
      contents: read
    concurrency:
      group: xdremux-styles-stage-diagnostic-${{ github.run_id }}-${{ github.run_attempt }}
      cancel-in-progress: false
    steps:
      - name: Preserve an initial receipt even if checkout fails
        id: initial
        shell: bash
        run: |
          python3 - <<'PYINIT'
          import json, os
          from pathlib import Path
          out = Path(os.environ['RUNNER_TEMP']) / ('styles-stage-initial-' + os.environ['GITHUB_RUN_ID'] + '-' + os.environ['GITHUB_RUN_ATTEMPT'])
          out.mkdir(exist_ok=False)
          data = {'status': 'checkout-not-complete', 'product': 'e1072a90e31b12861dfe8b9cf25e07ce75c17c44', 'harness': '1a1698e47e008b688cf5c3fc492dfc307b04ae1a', 'entrypoint': os.environ['GITHUB_SHA'], 'native_execution_claimed': False}
          (out / 'initial-status.json').write_text(json.dumps(data, indent=2) + '\n')
          with open(os.environ['GITHUB_OUTPUT'], 'a') as stream:
              stream.write('receipt_ready=true\n')
          PYINIT
      - uses: actions/checkout@v7
        with:
          ref: ${{ github.sha }}
          path: diagnostic-control
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/checkout@v7
        with:
          ref: e1072a90e31b12861dfe8b9cf25e07ce75c17c44
          path: product-source
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/checkout@v7
        with:
          ref: 1a1698e47e008b688cf5c3fc492dfc307b04ae1a
          path: reviewed-harness
          fetch-depth: 0
          persist-credentials: false
      - name: Run only the pinned Styles diagnostic
        id: diagnostic
        timeout-minutes: 110
        shell: bash
        env:
          REVIEWED_ENTRYPOINT_SHA: ${{ inputs.reviewed_entrypoint_sha }}
        run: |
          python3 diagnostic-control/scripts/performance/run_pinned_styles_diagnostic.py \
            --control-source "$GITHUB_WORKSPACE/diagnostic-control" \
            --product-source "$GITHUB_WORKSPACE/product-source" \
            --harness-source "$GITHUB_WORKSPACE/reviewed-harness" \
            --expected-control-sha "$REVIEWED_ENTRYPOINT_SHA" \
            --artifact-dir "$RUNNER_TEMP/styles-stage-text-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
      - name: Upload only owned text evidence
        timeout-minutes: 5
        if: ${{ always() && steps.diagnostic.outputs.artifact_ready == 'true' }}
        uses: actions/upload-artifact@v7
        with:
          name: styles-stage-diagnostic-${{ github.sha }}-${{ github.run_attempt }}
          retention-days: 1
          if-no-files-found: error
          include-hidden-files: false
          path: |
            ${{ runner.temp }}/styles-stage-text-${{ github.run_id }}-${{ github.run_attempt }}/*.json
            ${{ runner.temp }}/styles-stage-text-${{ github.run_id }}-${{ github.run_attempt }}/*.log

      - name: Preserve the initial partial receipt
        timeout-minutes: 5
        if: ${{ always() && steps.initial.outputs.receipt_ready == 'true' }}
        uses: actions/upload-artifact@v7
        with:
          name: styles-stage-setup-${{ github.sha }}-${{ github.run_attempt }}
          retention-days: 1
          if-no-files-found: error
          path: ${{ runner.temp }}/styles-stage-initial-${{ github.run_id }}-${{ github.run_attempt }}/initial-status.json
