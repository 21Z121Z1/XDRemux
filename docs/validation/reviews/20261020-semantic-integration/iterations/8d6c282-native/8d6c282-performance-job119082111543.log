2026-10-21T07:14:07.6673980Z [36;1m{[0m
2026-10-21T07:14:07.6674270Z [36;1m  echo "## XDRemux Rust performance and design"[0m
2026-10-21T07:14:07.6674620Z [36;1m  echo[0m
2026-10-21T07:14:07.6675170Z [36;1m  echo "Runner: GitHub Actions hosted $(sw_vers -productName) $(sw_vers -productVersion) ($(uname -m)), label xcode-27. These are not local-device measurements."[0m
2026-10-21T07:14:07.6676160Z [36;1m  echo "Product E2E timings include source I/O, parsing, Gain Map decode/reconstruction, codec work, HEIF assembly/publication, and Apple adapter/framework overhead where applicable."[0m
